.vercel
.env*

# Serverless functions are deployed straight from the working tree with
# `vercel --prod` (git deploys are disabled in vercel.json), so they never need
# to be committed here.
#
# A PATTERN, not a list of filenames: a per-file rule once failed to cover a
# newly added file, and a `git add -A` would have published it.
api/

# macOS metadata.
.DS_Store
